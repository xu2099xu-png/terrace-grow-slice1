{
  "name": "terrace-grow-server",
  "private": true,
  "scripts": {
    "build": "tsc",
    "tsc:watch": "tsc --watch --preserveWatchOutput",
    "start:watch": "node --watch dist/src/main.js",
    "dev": "npm run build && npm run start:watch",
    "start": "node dist/src/main.js",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:test:setup": "node scripts/test-db.js reset",
    "db:test:drop": "node scripts/test-db.js drop",
    "seed": "tsx prisma/seed.ts",
    "seed:test": "TEST_DATABASE_URL=postgresql://terrace:terrace@localhost:5433/terrace_grow_test?schema=public node scripts/test-db.js reset",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run test/",
    "test:slice2-gate": "vitest run test/slice2-gate.spec.ts",
    "test:slice3-gate": "vitest run test/slice3-gate.spec.ts",
    "test:e2e": "node test/integration-e2e.js",
    "test:h5": "npm --prefix ../h5 run test",
    "test:all": "npm run db:test:setup && npm run build && npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:h5"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.10.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
