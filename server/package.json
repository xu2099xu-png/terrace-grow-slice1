{
  "name": "terrace-grow-server",
  "private": true,
  "scripts": {
    "build": "tsc",
    "tsc:watch": "tsc --watch --preserveWatchOutput",
    "start:watch": "node --watch dist/src/main.js",
    "dev": "npm run build && npm run start:watch",
    "start": "node dist/src/main.js",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:test:setup": "node scripts/test-db.js reset",
    "db:test:drop": "node scripts/test-db.js drop",
    "seed": "tsx prisma/seed.ts",
    "seed:test": "TEST_DATABASE_URL=postgresql://terrace:terrace@localhost:5433/terrace_grow_test?schema=public node scripts/test-db.js reset",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run test/",
    "test:slice2-gate": "vitest run test/slice2-gate.spec.ts",
    "test:slice3-gate": "vitest run test/slice3-gate.spec.ts",
    "test:slice4-gate": "vitest run test/slice4-gate.spec.ts src/config/runtime-config.spec.ts",
    "test:slice5-gate": "vitest run test/slice5-gate.spec.ts test/slice5-http.spec.ts src/ai src/config/runtime-config.spec.ts",
    "test:migration-upgrade": "node scripts/migration-upgrade-test.js",
    "test:e2e": "node test/integration-e2e.js",
    "test:h5": "npm --prefix ../h5 run test",
    "test:all": "npm run db:test:setup && npm run build && npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:h5"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^4.1.10"
  }
}
