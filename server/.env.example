DATABASE_URL="postgresql://terrace:terrace@localhost:5433/terrace_grow?schema=public"
JWT_SECRET="replace-with-a-strong-secret-in-production"
PORT=3000
APP_ENV=development
# DEV ONLY: allow draft fixture data into engines. NOT approved agricultural content.
# Must be explicitly set to 'true' AND APP_ENV=development to allow draft data.
ALLOW_DRAFT_FIXTURES=true

# Optional real provider configuration. Without these, seasonal weather
# gracefully reports unavailable and location falls back to manual city choice.
QWEATHER_API_HOST="your-project.qweatherapi.com"
QWEATHER_KEY=""
LOCATION_API_KEY=""
